#!$PREFIX/bin/bash

if [ ! -d ~/storage ];
then
  termux-setup-storage
fi

sleep 5

DOCROOT="$HOME/storage/shared/htdocs"
mkdir -p "$DOCROOT"

pkg install php-apache -y

rm $PREFIX/etc/apache2/httpd.conf

cp httpd.conf $PREFIX/etc/apache2/

rm $PREFIX/etc/apache2/extra/httpd-ssl.conf

cp httpd-ssl.conf $PREFIX/etc/apache2/extra/

pkg install openssl-tool -y

openssl req -x509 -newkey rsa:2048 -keyout server.key -out server.crt -days 365 -nodes -subj '/CN=localhost'

mv -f server.crt $PREFIX/etc/apache2/

mv -f server.key $PREFIX/etc/apache2/

rm -f $PREFIX/bin/tamp

chmod +x tamp

cp tamp $PREFIX/bin/

pkg install mariadb composer -y

cp -n .htaccess "$DOCROOT/"

php_info="$DOCROOT/phpinfo"
if [ ! -d $php_info ];
then
  mkdir $php_info
  echo "<?php phpinfo(); ?>" > $php_info/index.php
fi

if [ ! -d "$DOCROOT/phpmyadmin" ];
then
  cd "$DOCROOT" && composer create-project phpmyadmin/phpmyadmin
fi

cd ~/tamp && cp -f config.inc.php "$DOCROOT/phpmyadmin/config.inc.php"

YELLOW='\033[0;33m'
NC='\033[0m' # No Color
echo "TAMP installed sucessfully."
echo "$DOCROOT - is your document directory."
echo "Place your files in $DOCROOT"
echo -e "Run: ${YELLOW}tamp start${NC}"

#tamp-setup
